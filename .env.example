# TronGrid API key (https://www.trongrid.io/) - required, avoids aggressive public rate limits
TRONGRID_API_KEY=

# Full node / TronGrid endpoint
TRON_FULL_HOST=https://api.trongrid.io

# Address that swept funds are sent to
COLLECTION_WALLET_ADDRESS=

# Balance threshold in TRX - crossing this triggers an immediate sweep
THRESHOLD_TRX=5

# TRX kept behind in the source wallet to cover bandwidth/energy burn for the sweep tx itself
RESERVE_TRX=1

# How often each wallet's balance is polled, in milliseconds
POLL_INTERVAL_MS=1000

# After a failed sweep attempt, how long to wait before retrying that wallet, in milliseconds
SWEEP_RETRY_COOLDOWN_MS=5000

# Local port for the status/health HTTP endpoint (nginx proxies to this, keep it bound to 127.0.0.1)
PORT=3300

# One private key per wallet declared in src/wallets.js, keyed by PK_<LABEL IN UPPERCASE>
# Example: a wallet with label "wallet01" needs PK_WALLET01 below
PK_WALLET01=
PK_WALLET02=
