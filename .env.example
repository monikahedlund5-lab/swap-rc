# TronGrid API key (https://www.trongrid.io/) - required, avoids aggressive public rate limits
TRONGRID_API_KEY=

# Full node / TronGrid endpoint
TRON_FULL_HOST=https://api.trongrid.io

# Address that swept funds are sent to
COLLECTION_WALLET_ADDRESS=

# Balance threshold in TRX - crossing this triggers an immediate sweep (only applies to
# wallets with asset: 'trx' in src/wallets.js)
THRESHOLD_TRX=5

# Balance threshold in USDT - crossing this triggers an immediate sweep (only applies to
# wallets with asset: 'usdt' in src/wallets.js)
THRESHOLD_USDT=5

# TRX kept behind in a trx-asset wallet to cover bandwidth/energy burn for the sweep tx itself
RESERVE_TRX=1

# feeLimit (in TRX) for USDT-TRC20 transfer calls. Paid from the wallet's own TRX/energy,
# not from the swept USDT - a usdt-asset wallet needs some TRX (or frozen energy) on hand
# or its sweeps will fail with an out-of-energy/bandwidth error.
TRC20_FEE_LIMIT_TRX=20

# Leave blank to use the official Tron mainnet USDT-TRC20 contract
# (TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t). Only override this if you have personally verified
# a different contract - usdt-asset wallets are swept only against this exact contract,
# never against a token found by name/symbol, since scam tokens frequently clone "USDT".
USDT_CONTRACT_ADDRESS=

# How often each wallet's balance is polled, in milliseconds
POLL_INTERVAL_MS=1000

# After a sweep attempt (success or failure), how long to pause checking that wallet, in
# milliseconds. Also covers TronGrid's balance-read lag after a successful sweep (can run
# a few seconds behind the confirmed block) - too short and a stale read can trigger a
# harmless duplicate sweep attempt against an already-swept balance. Lower this for
# tighter sweeping of rapid successive deposits; occasional benign duplicate-attempt log
# lines are the tradeoff (they're rejected before execution, no fee charged).
SWEEP_RETRY_COOLDOWN_MS=2000

# Local port for the status/health HTTP endpoint (nginx proxies to this, keep it bound to 127.0.0.1)
PORT=3300

# One private key per wallet declared in src/wallets.js, keyed by PK_<LABEL IN UPPERCASE>
# Example: a wallet with label "wallet01" needs PK_WALLET01 below
PK_WALLET01=
PK_WALLET02=
